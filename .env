# Base URL of the API. Leave empty in development: Vite proxies /api and /uploads to VITE_DEV_API_PROXY.
# Production example: https://api.amrutdurgotsav.com
VITE_API_URL=
# Where `npm run dev` forwards /api, /uploads and /sitemap.xml
VITE_DEV_API_PROXY=http://localhost:4100
# Canonical public URL of the website (canonical links, Open Graph, structured data)
VITE_SITE_URL=http://localhost:5173
